<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/row_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textColor="#334155" />
    <TextView android:id="@+id/row_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#334155" />
    <Chronometer android:id="@+id/row_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#526A91" />
</LinearLayout>
